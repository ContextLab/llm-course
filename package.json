{
  "name": "llm-course",
  "version": "1.0.0",
  "description": "Large Language Models Course - Interactive Demos and Tests",
  "type": "module",
  "scripts": {
    "test": "npm run test:all",
    "test:all": "npm run test:demo01 && npm run test:demo02 && npm run test:demo03 && npm run test:demo04 && npm run test:demo05 && npm run test:demo06 && (npm run test:demo07 || echo 'Demo 07 failed (known memory issue)') && npm run test:demo08 && npm run test:demo09 && npm run test:demo10 && npm run test:demo11 && npm run test:demo12 && npm run test:demo13 && npm run test:demo14 && npm run test:demo15",
    "test:demo01": "node tests/test-demo01-eliza.mjs",
    "test:demo02": "node tests/test-demo02-tokenization.mjs",
    "test:demo03": "node tests/test-demo03-clustering.mjs",
    "test:demo04": "node tests/test-demo04-attention.mjs",
    "test:demo05": "node tests/test-demo05-transformer.mjs",
    "test:demo06": "node tests/test-demo06-sampling.mjs",
    "test:demo07": "node tests/test-demo07-rag.mjs",
    "test:demo08": "node tests/test-demo08-lda.mjs",
    "test:demo09": "node tests/test-demo09-sentiment.mjs",
    "test:demo10": "node tests/test-demo10-pos.mjs",
    "test:demo11": "node tests/test-demo11-analogies.mjs",
    "test:demo12": "node tests/test-demo12-bm25.mjs",
    "test:demo13": "node tests/test-demo13-bert.mjs",
    "test:demo14": "node tests/test-demo14-comparison.mjs",
    "test:demo15": "npm run test:demo15:eliza && npm run test:demo15:parry && npm run test:demo15:alice",
    "test:demo15:eliza": "node tests/test-demo15-eliza-fixes.mjs",
    "test:demo15:parry": "node tests/test-demo15-parry-final.mjs",
    "test:demo15:alice": "node tests/test-demo15-alice-full.mjs",
    "test:chatbots": "npm run test:demo15",
    "test:eliza": "npm run test:demo01 && npm run test:demo15:eliza",
    "test:tokenization": "npm run test:demo02",
    "test:clustering": "npm run test:demo03",
    "test:attention": "npm run test:demo04",
    "test:transformer": "npm run test:demo05",
    "test:sampling": "npm run test:demo06",
    "test:rag": "npm run test:demo07",
    "test:lda": "npm run test:demo08",
    "test:sentiment": "npm run test:demo09",
    "test:pos": "npm run test:demo10",
    "test:analogies": "npm run test:demo11",
    "test:search": "npm run test:demo12",
    "test:bert": "npm run test:demo13",
    "test:comparison": "npm run test:demo14",
    "test:verbose": "npm test -- --verbose"
  },
  "keywords": [
    "llm",
    "machine-learning",
    "nlp",
    "transformers",
    "educational",
    "chatbots",
    "eliza",
    "parry",
    "alice",
    "bpe",
    "tokenization",
    "embeddings",
    "attention",
    "rag",
    "semantic-search"
  ],
  "author": "ContextLab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ContextLab/llm-course.git"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "compromise": "^14.14.5"
  }
}
